{
  "name": "@kayushkin/chat-core",
  "version": "0.0.1",
  "description": "Framework-light data layer for the dashv2 chat surface: in-memory store, IndexedDB cache, SSE sync engine, and a non-destructive turn reducer. Renders from memory; the network only reconciles.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.2.4",
    "typescript": "~5.9.3",
    "vitest": "^2.1.0",
    "fake-indexeddb": "^6.0.0"
  }
}
